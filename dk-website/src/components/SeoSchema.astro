---
/**
 * JSON-LD structured data. Gives search engines and AI assistants an explicit,
 * machine-readable description of who David is, what he does, where he is
 * based, which acts he plays in, and which shows are coming up.
 */
import { getCollection } from 'astro:content';
import { site, abs } from '../data/site';

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = abs('/', origin);
const personId = `${pageUrl}#person`;

/** "DD.MM.YYYY" / "DD.MM.YY" -> "YYYY-MM-DD" (schema.org needs ISO 8601). */
function isoDate(date: string): string | null {
  const m = date.trim().match(/^(\d{1,2})\.(\d{1,2})\.(\d{2,4})$/);
  if (!m) return null;
  const [, d, mo, y] = m;
  const year = y.length === 2 ? `20${y}` : y;
  return `${year}-${mo.padStart(2, '0')}-${d.padStart(2, '0')}`;
}

const shows = await getCollection('shows');
const events = shows
  .map((show) => {
    const start = isoDate(show.data.date);
    if (!start) return null;
    return {
      '@type': 'MusicEvent',
      name: `${show.data.act} live at ${show.data.venue}`,
      startDate: start,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: show.data.venue,
        address: {
          '@type': 'PostalAddress',
          addressLocality: show.data.city,
        },
      },
      performer: [
        { '@type': 'MusicGroup', name: show.data.act },
        { '@id': personId },
      ],
      ...(show.data.url ? { url: show.data.url } : {}),
    };
  })
  .filter(Boolean);

const person = {
  '@type': 'Person',
  '@id': personId,
  name: site.name,
  alternateName: 'David Kraehenbuehl',
  url: pageUrl,
  image: abs(site.ogImage, origin),
  email: `mailto:${site.email}`,
  description: site.description,
  disambiguatingDescription: site.descriptionDe,
  jobTitle: [...site.jobTitles],
  knowsAbout: [...site.knowsAbout],
  knowsLanguage: ['de', 'en'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.locality,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  homeLocation: {
    '@type': 'Place',
    name: `${site.locality}, ${site.countryName}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.geo.lat,
      longitude: site.geo.lon,
    },
  },
  memberOf: site.acts.map((act) => ({
    '@type': 'MusicGroup',
    name: act.name,
    url: act.url,
  })),
  sameAs: [site.instagram, site.instrumentor, ...site.acts.map((a) => a.url)],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Drum lessons and music production coaching',
      alternateName: 'Schlagzeugunterricht in Zürich',
      serviceType: 'Drum lessons',
      description:
        'Drum lessons from hip-hop to pop — groove, phrasing and playing in bands — ' +
        'plus mixing and producing with Logic and Ableton Live. In Zurich, for ' +
        'beginners and advanced players, in German or English.',
      areaServed: {
        '@type': 'City',
        name: site.locality,
      },
      provider: { '@id': personId },
      url: site.instrumentor,
    },
  },
};

const website = {
  '@type': 'WebSite',
  '@id': `${pageUrl}#website`,
  url: pageUrl,
  name: `${site.name} — ${site.tagline}`,
  inLanguage: 'en',
  description: site.description,
  publisher: { '@id': personId },
  about: { '@id': personId },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: site.socialTitle,
  description: site.description,
  isPartOf: { '@id': `${pageUrl}#website` },
  about: { '@id': personId },
  primaryImageOfPage: abs(site.ogImage, origin),
  inLanguage: 'en',
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [person, website, webpage, ...events],
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
