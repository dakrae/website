---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Collaborations from '../components/Collaborations.astro';
import Videos from '../components/Videos.astro';
import Live from '../components/Live.astro';
import Lessons from '../components/Lessons.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---
<Layout title={site.title} description={site.description}>
  <Header />
  <Hero />
  <Collaborations />
  <Videos />
  <Live />
  <Lessons />
  <Contact />
  <Footer />
</Layout>
